<?xml version="1.0"?>
<package format="3">
  <name>robot_chassis</name>
  <version>0.1.0</version>
  <description>Chassis sensing, row navigation, and STM32 serial bridge.</description>
  <maintainer email="robot@example.invalid">robot_arm_jetson</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>behaviortree_cpp_v3</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>robot_arm_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>robot_sensors</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
