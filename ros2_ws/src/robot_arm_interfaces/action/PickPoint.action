# Target point must already be expressed in the robot base frame.
geometry_msgs/PointStamped target
float64 approach_height_m
float64 grasp_offset_x_m
float64 grasp_offset_y_m
float64 grasp_offset_z_m
float64 target_tool_tilt #joint4相对于水平面，不是kdl默认的相对于base_link
float64 target_joint5 #joint5相对于自身轴线
#float64 target_pitch 
#float64 target_roll 
builtin_interfaces/Duration duration
bool return_home
---
bool success
string message
geometry_msgs/PointStamped final_position
---
float32 progress
string stage
